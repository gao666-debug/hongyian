# 复制为 .env 后填写。密码类字段留空时，python tools_init.py 会自动生成。
BACKEND_MODE=mock
APP_USERNAME=guardian
APP_PASSWORD=
WEBHOOK_TOKEN=

# 设备白名单：逗号分隔。App 登录后返回的 device_ids 就是这里列出的设备。
DEVICE_ID=demo-device
# 手表是独立设备，但数据挂在 DEVICE_ID 的第一台（主设备）下，
# 所以它不写进 DEVICE_ID，单独配在这里。留空 = 没有手表。
WATCH_DEVICE_ID=
# 手表物模型的服务 ID（华为云产品「22」是 11）
WATCH_SERVICE_ID=11

IOTDA_ENDPOINT=https://YOUR_INSTANCE.iotda-app.cn-east-3.myhuaweicloud.com
IOTDA_REGION=cn-east-3
IOTDA_PROJECT_ID=
HUAWEICLOUD_SDK_AK=
HUAWEICLOUD_SDK_SK=
CORS_ORIGINS=

# 华为云 AMQP 接入凭据（应用侧消费用），绝不放进 App。
# ⚠️ 这组凭据会过期，且过期后已建立的连接不会断，只在重启服务时才暴露
#    （表现为 Transport failure; reconnecting 死循环）。
AMQP_HOST=
AMQP_ACCESS_KEY=
AMQP_ACCESS_CODE=
AMQP_QUEUE=
AMQP_INSTANCE_ID=

# 可选：也支持将环境节点直接列在 DEVICE_ID 中。
NEARLINK_A_DEVICE_ID=
# 本地 API 地址与证书，保持与实际部署一致。
AMQP_LOCAL_BACKEND=https://127.0.0.1:8443
# 默认关闭报警抓拍联动；确认报警代码后再配置。
CAPTURE_ALARM_CODES=
