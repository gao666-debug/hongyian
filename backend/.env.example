# Run python tools_init.py to generate private local credentials first.
BACKEND_MODE=mock
APP_USERNAME=guardian
APP_PASSWORD=
WEBHOOK_TOKEN=
DEVICE_ID=demo-device
# 手表（WS63 穿戴节点）在 IoTDA 里是另一台直连设备；不填表示与 DEVICE_ID 相同
WATCH_DEVICE_ID=
# 产品物模型里的服务 ID：主板 HomeSafety，手表是产品侧自定义的（本项目实测是 11）
IOTDA_SERVICE_ID=HomeSafety
WATCH_SERVICE_ID=11
IOTDA_ENDPOINT=https://YOUR_INSTANCE.iotda-app.cn-east-3.myhuaweicloud.com
IOTDA_REGION=cn-east-3
IOTDA_PROJECT_ID=
HUAWEICLOUD_SDK_AK=
HUAWEICLOUD_SDK_SK=
CORS_ORIGINS=

# Existing IoTDA AMQP credentials; never put these into the App
AMQP_HOST=
AMQP_ACCESS_KEY=
AMQP_ACCESS_CODE=
AMQP_QUEUE=
AMQP_INSTANCE_ID=
